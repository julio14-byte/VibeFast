# ============================================================
# VibeFast — Variables de entorno
# Copia este archivo a .env.local y rellena los valores
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# Encuentra estas keys en: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- IA (elige UNA opción) ---

# Opción A · OpenAI directo (recomendado para SmartPOS)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opción B · Cursor (key crsr_... + proxy OpenAI-compatible local)
# Key: https://cursor.com/dashboard → Integrations → User API Keys
# Cursor NO expone chat/completions en api.cursor.com; necesitas un
# proxy local (ej. cursor-cli-api-proxy en http://localhost:3457/v1).
# CURSOR_API_KEY=
# CURSOR_API_BASE_URL=http://localhost:3457/v1
# CURSOR_MODEL=composer-2.5

# --- Resend (email) ---
# https://resend.com/api-keys
RESEND_API_KEY=

# --- PostHog (opcional, analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- OAuth providers (Gmail receta, opcional) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- WhatsApp Cloud API (opcional, envío automático CFDI) ---
# Meta Business → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
